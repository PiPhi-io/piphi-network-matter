{
  "name": "piphi-network-matter",
  "version": "0.2.0-alpha.1",
  "description": "Matter.js controller sidecar for PiPhi Network.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "validate": "node scripts/validate.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@matter-server/ws-client": "1.4.0",
    "fastify": "^5.6.2",
    "matter-server": "1.4.0",
    "piphi-runtime-kit-node": "^0.4.0"
  },
  "optionalDependencies": {
    "@matter/nodejs-ble": "0.17.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
